<?xml version="1.0" encoding="utf-8"?>
<!-- 选集下载抽屉：头部（下载 / 下载列表 >）+ 分段标签 + 可滚动剧集网格 -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_episode_sheet_bg"
    android:orientation="vertical">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:alpha="0.35"
        android:background="@drawable/shape_episode_sheet_handle" />

    <androidx.appcompat.widget.LinearLayoutCompat
        style="@style/DetailSectionHeader"
        android:layout_marginTop="8dp">

        <com.google.android.material.textview.MaterialTextView
            style="@style/DetailSectionTitle"
            android:text="@string/detail_download" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/downloadList"
            style="@style/DetailSectionAction"
            android:layout_marginEnd="-8dp"
            android:text="@string/detail_download_list"
            app:drawableEndCompat="@drawable/ic_detail_chevron_right"
            app:drawableTint="@color/selector_detail_action_text" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/group"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="4"
        tools:listitem="@layout/adapter_episode_group_tab"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/episode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="4"
        tools:itemCount="28"
        tools:listitem="@layout/adapter_episode_grid" />

</androidx.appcompat.widget.LinearLayoutCompat>
