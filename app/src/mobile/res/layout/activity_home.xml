<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Telegram（v12.4 Liquid Glass）风格底栏：半透明悬浮胶囊 + 等宽 Tab + 滑动选中气泡
         forceDarkAllowed=false：底栏及子 View 不参与系统强制深色，深色模式直接用 values-night 里的 nav_* 颜色。
         否则强制深色会把半透明白色气泡（#24FFFFFF）当成浅色背景压暗，在深色胶囊上看不见。 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="18dp"
        android:forceDarkAllowed="false"
        android:theme="@style/ThemeOverlay.WebHTV.NavCapsule"
        tools:targetApi="q"
        app:cardBackgroundColor="@color/nav_capsule_bg"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp"
        app:cardMaxElevation="8dp"
        app:strokeColor="@color/nav_capsule_stroke"
        app:strokeWidth="0.5dp">

        <!-- 高度 56dp 与 VodFragment / WebTabFragment / FAB 中的胶囊尺寸常量保持一致 -->
        <FrameLayout
            android:id="@+id/navigation"
            android:layout_width="wrap_content"
            android:layout_height="56dp">

            <!-- 选中气泡：位置由 HomeActivity.moveNavIndicator() 通过 translationX 控制 -->
            <View
                android:id="@+id/navIndicator"
                android:layout_width="@dimen/nav_item_width"
                android:layout_height="match_parent"
                android:layout_gravity="left"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/shape_nav_indicator"
                android:importantForAccessibility="no"
                android:visibility="invisible"
                tools:ignore="RtlHardcoded" />

            <LinearLayout
                android:id="@+id/navItems"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/navVod"
                    style="@style/NavItem">

                    <ImageView
                        android:id="@+id/navVodIcon"
                        style="@style/NavItemIcon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_vod" />

                    <TextView
                        android:id="@+id/navVodText"
                        style="@style/NavItemText"
                        android:text="@string/nav_vod" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/navKeep"
                    style="@style/NavItem">

                    <ImageView
                        android:id="@+id/navKeepIcon"
                        style="@style/NavItemIcon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_keep" />

                    <TextView
                        android:id="@+id/navKeepText"
                        style="@style/NavItemText"
                        android:text="@string/nav_keep" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/navWeb"
                    style="@style/NavItem">

                    <ImageView
                        android:id="@+id/navWebIcon"
                        style="@style/NavItemIcon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_web" />

                    <TextView
                        android:id="@+id/navWebText"
                        style="@style/NavItemText"
                        android:text="@string/nav_web" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/navSetting"
                    style="@style/NavItem">

                    <ImageView
                        android:id="@+id/navSettingIcon"
                        style="@style/NavItemIcon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_setting" />

                    <TextView
                        android:id="@+id/navSettingText"
                        style="@style/NavItemText"
                        android:text="@string/nav_setting" />
                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent"
        android:clickable="true"
        android:elevation="999dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/loadingProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/loading_indicator"
                app:indicatorSize="44dp"
                app:trackCornerRadius="2dp"
                app:trackThickness="3.5dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:text="@string/loading_source"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

        </LinearLayout>

    </FrameLayout>

</RelativeLayout>
