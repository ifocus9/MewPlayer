<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="18dp"
        android:theme="@style/ThemeOverlay.WebHTV.NavCapsule"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="30dp"
        app:cardElevation="8dp"
        app:cardMaxElevation="10dp"
        app:strokeColor="@color/nav_capsule_stroke"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/navigation"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/navVod"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:background="@drawable/selector_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="66dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/navVodIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_nav_vod"
                    app:tint="@color/selector_nav_capsule" />

                <TextView
                    android:id="@+id/navVodText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:duplicateParentState="true"
                    android:includeFontPadding="false"
                    android:text="@string/nav_vod"
                    android:textColor="@color/selector_nav_capsule"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navKeep"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:background="@drawable/selector_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="66dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/navKeepIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_nav_keep"
                    app:tint="@color/selector_nav_capsule" />

                <TextView
                    android:id="@+id/navKeepText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:duplicateParentState="true"
                    android:includeFontPadding="false"
                    android:text="@string/nav_keep"
                    android:textColor="@color/selector_nav_capsule"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navSetting"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:background="@drawable/selector_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="66dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/navSettingIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_nav_setting"
                    app:tint="@color/selector_nav_capsule" />

                <TextView
                    android:id="@+id/navSettingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:duplicateParentState="true"
                    android:includeFontPadding="false"
                    android:text="@string/nav_setting"
                    android:textColor="@color/selector_nav_capsule"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent"
        android:clickable="true"
        android:elevation="999dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/loadingProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/loading_indicator"
                app:indicatorSize="44dp"
                app:trackCornerRadius="2dp"
                app:trackThickness="3.5dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:text="@string/loading_source"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

        </LinearLayout>

    </FrameLayout>

</RelativeLayout>
