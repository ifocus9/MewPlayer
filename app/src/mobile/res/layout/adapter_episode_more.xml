<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页选集横排末尾的“更多”卡片；高度由 EpisodeMoreAdapter 跟随剧集卡片设置 -->
<com.google.android.material.textview.MaterialTextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/text"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:background="@drawable/shape_video_episode_grid"
    android:drawablePadding="2dp"
    android:focusable="true"
    android:gravity="center"
    android:minWidth="72dp"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:singleLine="true"
    android:text="@string/detail_episode_more"
    android:textColor="@color/detail_text_meta"
    android:textSize="14sp"
    app:drawableEndCompat="@drawable/ic_detail_chevron_right"
    app:drawableTint="@color/detail_text_meta" />
