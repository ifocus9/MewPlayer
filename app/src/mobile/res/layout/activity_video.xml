<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/detail_bg"
    android:tag="port">

    <com.fongmi.android.tv.ui.custom.ContextWallImageView
        android:id="@+id/contextWall"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/video"
        android:layout_alignParentBottom="true"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/black" />

    <FrameLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_below="@+id/statusBar"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="true">

        <androidx.media3.ui.PlayerView
            android:id="@+id/exo"
            style="@style/Player.Vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:surface_type="none" />

        <include
            android:id="@+id/widget"
            layout="@layout/view_widget_vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.fongmi.android.tv.ui.custom.LyricsOverlayView
            android:id="@+id/lyrics"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.fongmi.android.tv.ui.custom.KaraokeStatusView
            android:id="@+id/karaoke"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp" />

        <include
            android:id="@+id/control"
            layout="@layout/view_control_vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/progress"
            layout="@layout/view_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/osd"
            layout="@layout/view_player_osd"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.fongmi.android.tv.ui.custom.LutQuickPanel
            android:id="@+id/lutQuick"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/discTools"
            layout="@layout/view_disc_menu_tools"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:visibility="gone" />

    </FrameLayout>

    <View
        android:id="@+id/videoShadow"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_below="@+id/video"
        android:background="@drawable/shadow" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/video">

        <com.fongmi.android.tv.ui.custom.ProgressLayout
            android:id="@+id/progressLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.fongmi.android.tv.ui.custom.FixedNestedScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="48dp">

                    <FrameLayout
                        android:id="@+id/audioStage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/shape_audio_player_background"
                        android:clickable="true"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:focusable="true"
                        android:paddingStart="24dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="14dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/audioHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|center_horizontal"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/audioDisc"
                            android:layout_width="184dp"
                            android:layout_height="184dp"
                            android:background="@drawable/shape_audio_disc_back"
                            android:padding="12dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/audioCover"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/artwork"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.WebHTV.AudioCover"
                                app:strokeColor="@color/white_20"
                                app:strokeWidth="1dp" />

                        </FrameLayout>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/audioTitle"
                            style="@style/Video.ContextText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="2"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="八段锦口令音乐" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/audioSubtitle"
                            style="@style/Video.ContextText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:textColor="@color/white_70"
                            android:textSize="13sp"
                            tools:text="站源 · 当前播放列表" />

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/audioBadges"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/audioBadgeFormat"
                                style="@style/Video.ContextText"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:background="@drawable/shape_audio_badge"
                                android:gravity="center"
                                android:minWidth="58dp"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="@string/player_audio_badge_audio"
                                android:textColor="@color/white_90"
                                android:textSize="12sp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/audioBadgeLyrics"
                                style="@style/Video.ContextText"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/shape_audio_badge"
                                android:gravity="center"
                                android:minWidth="58dp"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="@string/player_audio_badge_lyrics"
                                android:textColor="@color/white_90"
                                android:textSize="12sp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/audioBadgeQueue"
                                style="@style/Video.ContextText"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/shape_audio_badge"
                                android:gravity="center"
                                android:minWidth="58dp"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="@string/player_audio_badge_queue"
                                android:textColor="@color/white_90"
                                android:textSize="12sp" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <com.fongmi.android.tv.ui.custom.LyricsOverlayView
                            android:id="@+id/audioLyrics"
                            android:layout_width="match_parent"
                            android:layout_height="164dp"
                            android:layout_gravity="center" />

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/audioBottomPanel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                        <com.fongmi.android.tv.ui.custom.KaraokeStatusView
                            android:id="@+id/audioKaraoke"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" />

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/audioPlaybackPanel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="2dp">

                            <com.fongmi.android.tv.ui.custom.CustomSeekView
                                android:id="@+id/audioSeek"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:id="@+id/audioTransport"
                                android:layout_width="match_parent"
                                android:layout_height="58dp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/audioRepeatAction"
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:padding="9dp"
                                    android:scaleType="center"
                                    android:src="@drawable/ic_audio_repeat" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/audioPrev"
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:layout_marginStart="8dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:padding="9dp"
                                    android:scaleType="center"
                                    android:src="@drawable/exo_icon_previous" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/audioPlay"
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:layout_marginStart="20dp"
                                    android:layout_marginEnd="20dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:padding="9dp"
                                    android:scaleType="center"
                                    android:src="@drawable/exo_icon_play" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/audioNext"
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:layout_marginEnd="8dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:padding="9dp"
                                    android:scaleType="center"
                                    android:src="@drawable/exo_icon_next" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/audioQueueAction"
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:padding="9dp"
                                    android:scaleType="center"
                                    android:src="@drawable/ic_audio_queue" />

                            </androidx.appcompat.widget.LinearLayoutCompat>

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/audioActionRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/audioLyricsAction"
                                style="@style/AudioActionButton"
                                android:layout_marginEnd="4dp"
                                android:text="@string/player_lyrics_search"
                                app:drawableTopCompat="@drawable/ic_audio_lyrics" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/audioKaraokeAction"
                                style="@style/AudioActionButton"
                                android:layout_marginEnd="4dp"
                                android:text="@string/player_audio_options"
                                app:drawableTopCompat="@drawable/ic_action_ktv" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/audioMoreAction"
                                style="@style/AudioActionButton"
                                android:text="@string/player_audio_more"
                                app:drawableTopCompat="@drawable/ic_audio_more" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/audioToolRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/audioCastAction"
                                style="@style/VideoActionButton"
                                android:layout_marginEnd="4dp"
                                android:text="@string/play_cast"
                                app:drawableTopCompat="@drawable/ic_control_cast_shadow" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/audioSettingAction"
                                style="@style/VideoActionButton"
                                android:layout_marginEnd="4dp"
                                android:text="@string/nav_setting"
                                app:drawableTopCompat="@drawable/ic_control_setting_shadow" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/audioTrackAction"
                                style="@style/VideoActionButton"
                                android:layout_marginEnd="4dp"
                                android:text="@string/play_track_audio"
                                app:drawableTopCompat="@drawable/ic_action_audio" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/audioSubtitleAction"
                                style="@style/VideoActionButton"
                                android:layout_marginEnd="4dp"
                                android:text="@string/play_track_text"
                                app:drawableTopCompat="@drawable/ic_action_subtitle" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/audioInfoAction"
                                style="@style/VideoActionButton"
                                android:text="@string/player_osd"
                                app:drawableTopCompat="@drawable/ic_control_info" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        </FrameLayout>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/audioBackgroundAction"
                            android:layout_width="92dp"
                            android:layout_height="142dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="-18dp"
                            android:layout_marginEnd="-24dp"
                            android:background="@null"
                            android:contentDescription="@string/player_audio_background"
                            android:padding="0dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/audio_background_drip" />

                    </FrameLayout>

                    <!-- 详情头部：左侧海报，右侧 标题 / 年份·地区·类型·备注 / 站源标签 / 导演 / 主演；简介在下方全宽 -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/poster"
                            android:layout_width="90dp"
                            android:layout_height="126dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/detail_chip"
                            android:contentDescription="@string/detail_poster"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.WebHTV.DetailPoster" />

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="@color/detail_text_primary"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    tools:text="慶餘年第二季" />

                            </androidx.appcompat.widget.LinearLayoutCompat>

                            <!-- 年份 · 地区 · 类型 · 备注（如 全40集），合成一行 -->
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/other"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:textColor="@color/detail_text_body"
                                android:textSize="13sp"
                                tools:text="2022 · 台灣 · 科幻 · 全40集" />

                            <!-- 站源：小胶囊标签 -->
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/site"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/shape_detail_tag"
                                android:ellipsize="end"
                                android:maxWidth="200dp"
                                android:singleLine="true"
                                android:textColor="@color/detail_accent"
                                android:textSize="12sp"
                                tools:text="泥巴" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/director"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/detail_text_meta"
                                android:textSize="13sp"
                                tools:text="導演：FongMi" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/actor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/detail_text_meta"
                                android:textSize="13sp"
                                tools:text="演員：FongMi" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <!-- 简介：海报下方全宽显示，超出 3 行时末尾给出“展开” -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/content_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/content"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:lineSpacingExtra="4dp"
                            android:maxLines="3"
                            android:textColor="@color/detail_text_body"
                            android:textSize="13sp"
                            tools:text="一個身世神秘的少年范閒，因對自身身世的好奇而離開故鄉澹州，前赴南慶京都。" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/contentMore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:text="@string/detail_content_more"
                            android:textColor="@color/detail_accent"
                            android:textSize="13sp"
                            android:visibility="gone"
                            tools:visibility="visible" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/flagLayout"
                        style="@style/DetailSectionHeader"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/DetailSectionTitle"
                            android:text="@string/detail_flag" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/flagCount"
                            style="@style/DetailSectionMeta"
                            tools:text="共 2 条" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/flag"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:visibility="visible" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/quality_text"
                        style="@style/DetailSectionTitle"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginEnd="16dp"
                        android:text="@string/detail_quality"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/quality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:visibility="visible" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/episodeLayout"
                        style="@style/DetailSectionHeader"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/DetailSectionTitle"
                            android:text="@string/detail_episode" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <!-- “全N集 ›”：点击打开全部剧集抽屉（倒序 / 精简 / 分段都在抽屉里） -->
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/episodeCount"
                            style="@style/DetailSectionMeta"
                            android:layout_marginEnd="-8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:drawablePadding="2dp"
                            android:gravity="center_vertical"
                            android:minHeight="36dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="4dp"
                            app:drawableEndCompat="@drawable/ic_detail_chevron_right"
                            app:drawableTint="@color/detail_text_meta"
                            tools:text="全40集" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <!-- 选集横排：当前集自动居中，末尾“更多”卡片打开抽屉 -->
                    <com.fongmi.android.tv.ui.custom.CustomRecyclerView
                        android:id="@+id/episode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:orientation="horizontal"
                        android:overScrollMode="never"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="8"
                        tools:listitem="@layout/adapter_episode_row" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/quick"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="2"
                        tools:listitem="@layout/adapter_quick"
                        tools:visibility="visible" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.fongmi.android.tv.ui.custom.FixedNestedScrollView>
        </com.fongmi.android.tv.ui.custom.ProgressLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</RelativeLayout>