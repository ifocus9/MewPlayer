<?xml version="1.0" encoding="utf-8"?>
<!-- 全屏选集面板（EpisodeListDialog）里的线路 / 分段 / 选集按钮：与定时、标题等播放器面板同色的深色玻璃风格，不随日夜模式变化 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33C4BCFF">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#A83A7088" />
                    <stroke android:width="1dp" android:color="#CC73DDF7" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#A83A7088" />
                    <stroke android:width="1dp" android:color="#CC73DDF7" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#B35955A5" />
                    <stroke android:width="2dp" android:color="#E6C7C2FF" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#B35955A5" />
                    <stroke android:width="1dp" android:color="#BFC7C2FF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#78383C73" />
                    <stroke android:width="1dp" android:color="#3D9B9FD0" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
