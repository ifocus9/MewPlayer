<?xml version="1.0" encoding="utf-8"?>
<!-- 站源/网页胶囊（悬浮式）：实色底 + 视图 elevation 投影，不加描边。
     外层 ripple 提供按压反馈；LayerDrawable 会把内层 shape 的圆角轮廓交给 elevation 生成阴影。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/nav_indicator_color">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/site_capsule_bg" />
        </shape>
    </item>
</ripple>
