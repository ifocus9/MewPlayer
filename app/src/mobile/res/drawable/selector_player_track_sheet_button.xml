<?xml version="1.0" encoding="utf-8"?>
<!-- 字幕/音轨/视轨列表项：与全屏 LUT 快捷面板（LutQuickPanel.applyBg）同一套配色 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#11FFFFFF" />
                    <stroke android:width="1dp" android:color="#1AFFFFFF" />
                    <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" />
                </shape>
            </item>
            <item android:state_focused="true" android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#FF2F80ED" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                    <padding android:left="11dp" android:top="7dp" android:right="11dp" android:bottom="7dp" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#FF2F80ED" />
                    <stroke android:width="1dp" android:color="#FFFFFFFF" />
                    <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#55FFFFFF" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                    <padding android:left="11dp" android:top="7dp" android:right="11dp" android:bottom="7dp" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#55FFFFFF" />
                    <stroke android:width="1dp" android:color="#FFFFFFFF" />
                    <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#22FFFFFF" />
                    <stroke android:width="1dp" android:color="#33FFFFFF" />
                    <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
