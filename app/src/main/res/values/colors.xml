    <!-- 启动器图标背景（浅蓝灰，避免白色 M 与纯白底融在一起） -->
    <color name="ic_launcher_background">#EEF1F8</color>

    <!-- 首页底栏（Telegram 风格半透明悬浮胶囊） -->
    <color name="nav_capsule_bg">#E6FFFFFF</color>
    <color name="nav_capsule_stroke">#14000000</color>
    <!-- 首页悬浮按钮（回到顶部 / 筛选）底色：必须不透明。半透明底会透出按钮下方的阴影，
         系统把小圆的阴影近似成多边形，透出来就是中间一块六边形色块 -->
    <color name="fab_capsule_bg">#FFFFFF</color>
    <color name="bg_setting">#F5F6F8</color>
    <color name="nav_indicator_color">#12000000</color>
    <color name="nav_item_selected">#217AF4</color>
    <color name="nav_item_unselected">#1A1A1A</color>
    <!-- 站源胶囊（悬浮式）：不透明白底，靠 elevation 阴影与背景区分 -->
    <color name="site_capsule_bg">#FFFFFF</color>
    <!-- 胶囊关闭了强制深色，文字/图标颜色需按日夜模式自己给 -->
    <color name="site_capsule_text">#1A1A1A</color>
    <color name="site_capsule_icon">#555555</color>
    <color name="type_indicator_color">#1E88E5</color>
