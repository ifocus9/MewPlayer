    <color name="detail_chip_focused">#E9EBEF</color>
    <color name="detail_chip_selected">#E8F1FE</color>
    <color name="detail_text_primary">#1A1A1A</color>
    <color name="detail_text_body">#3C4043</color>
    <!-- 白底上约 4.6:1，满足小字号对比度建议值 -->
    <color name="detail_text_meta">#70757A</color>
    <!-- 详情页强调色（选中文字、站源标签、展开、下划线、播放中标记） -->
    <color name="detail_accent">#217AF4</color>
    <color name="loading_indicator">#666666</color>

