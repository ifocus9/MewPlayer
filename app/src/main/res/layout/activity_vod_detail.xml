<?xml version="1.0" encoding="utf-8"?>
<!-- 大画报详情页布局 —— 严格按截图2设计：全屏高斯模糊海报底图 + 渐变遮罩 + 大画报艺术水印 + 评分徽章 + 3行折叠简介 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tmdb_bg">

    <!-- ① 全屏高斯模糊海报底层背景图（完全对齐截图2：非纯色，由当前海报高斯模糊渲染） -->
    <ImageView
        android:id="@+id/globalBlurBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:scaleX="1.25"
        android:scaleY="1.25"
        android:contentDescription="@null" />

    <!-- 全屏柔和渐变磨砂遮罩 (对齐 AVBox 0.22f -> 0.48f -> 0.80f，透出海报原色) -->
    <View
        android:id="@+id/globalScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tmdb_backdrop_scrim" />

    <!-- ② 主体滚动区 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 顶部 Hero 区域 (全宽高清画报轮播 + 底部平滑透明淡出融入高斯模糊背景) -->
            <com.fongmi.android.tv.ui.custom.FadingFrameLayout
                android:id="@+id/heroBox"
                android:layout_width="match_parent"
                android:layout_height="520dp">

                <!-- 占位底层背景图 -->
                <ImageView
                    android:id="@+id/backdropBlur"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null" />

                <!-- 全宽高清画报轮播 (无圆点指示器) -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/backdropPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- 隐藏的旧桩，兼容代码引用 -->
                <ImageView
                    android:id="@+id/posterImage"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <!-- 顶部半透明遮罩，保证状态栏和左上角返回按钮可读 -->
                <View
                    android:id="@+id/topScrim"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_gravity="top"
                    android:background="@drawable/tmdb_top_scrim" />

            </com.fongmi.android.tv.ui.custom.FadingFrameLayout>

            <!-- 影片核心信息容器 (位于画报下方，背景为通透高斯模糊海报) -->
            <LinearLayout
                android:id="@+id/infoContentBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="6dp">

                <!-- 标题行：片名 + 评分徽章 (对齐截图2：风暴生日宴  ★ 8.2) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/titleText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/tmdb_text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="风暴生日宴" />

                    <!-- 评分胶囊徽章 (对齐截图2：★ 8.2) -->
                    <LinearLayout
                        android:id="@+id/ratingBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/tmdb_rating_badge_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginStart="12dp">

                        <ImageView
                            android:id="@+id/starIcon"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_star_filled"
                            app:tint="#FFC107"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/ratingText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="8.2" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 外文原名（若有） -->
                <TextView
                    android:id="@+id/originalTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/tmdb_text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Stormen" />

                <!-- 元信息行：2026-10-15 · 喜剧, 剧情 · 0 min (左对齐) -->
                <TextView
                    android:id="@+id/metaText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#D0D0D0"
                    android:textSize="13sp"
                    tools:text="2026-10-15 · 喜剧, 剧情 · 0 min" />

                <!-- 兼容隐藏桩 -->
                <TextView
                    android:id="@+id/voteCountText"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- 立即播放主胶囊按钮 (磨砂半透明长圆药丸，居中显示“播放”) -->
                <TextView
                    android:id="@+id/playButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/tmdb_play_capsule_bg"
                    android:gravity="center"
                    android:text="@string/play"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- 影片剧情简介（3行折叠，点击展开/收起，左对齐） -->
                <TextView
                    android:id="@+id/overviewText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:textColor="#D0D0D0"
                    android:textSize="13.5sp"
                    android:lineSpacingMultiplier="1.45"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:clickable="true"
                    android:focusable="true"
                    tools:text="几个大学老友被一场暴风雪困在了一家豪华旅馆，原本其乐融融的庆生宴随之演变成一场背叛、怨恨和不折不扣的混乱。" />

                <!-- 兼容隐藏桩 -->
                <TextView
                    android:id="@+id/overviewExpand"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/sectionOverview"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ① 演职人员分区 (首屏底部微露，下滑完全呈现) -->
            <LinearLayout
                android:id="@+id/castSectionBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/sectionCast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/tmdb_cast"
                    android:textColor="@color/tmdb_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/castRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="4dp"
                    android:overScrollMode="never" />

            </LinearLayout>

            <!-- ② 主创团队分区 -->
            <LinearLayout
                android:id="@+id/crewSectionBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/sectionCrew"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/tmdb_crew"
                    android:textColor="@color/tmdb_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/crewRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="4dp"
                    android:overScrollMode="never" />

            </LinearLayout>

            <!-- ③ 猜你喜欢推荐分区 -->
            <LinearLayout
                android:id="@+id/recommendSectionBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="40dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/sectionRecommend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/tmdb_recommendations"
                    android:textColor="@color/tmdb_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recommendRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="8dp"
                    android:overScrollMode="never" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- 顶部常驻浮动导航栏（左侧返回，右侧重新匹配编辑） -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="36dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/tmdb_circle_button_bg"
            android:scaleType="centerInside"
            android:contentDescription="Back" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/rematchButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/white"
            android:background="@drawable/tmdb_circle_button_bg"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/tmdb_rematch" />

    </LinearLayout>

    <!-- 加载转圈遮罩 -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#800D0D0D"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/colorPrimary" />

    </FrameLayout>

</FrameLayout>
